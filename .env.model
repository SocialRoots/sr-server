# =============================================================================
# SOCIALROOTS server — environment template
# Copy to .env and edit. All variables are consumed by docker-compose*.yml,
# the Go microservices, or the bin/ helpers.
# =============================================================================

#### CORE ####
# Runtime environment: development | staging | production
ENV=development
# Local loopback environment flag (dev conveniences, e.g. promiscuous email)
LOCALENV=true
# Image tag for ghcr.io/socialroots/* — every service image in the compose
# files is pinned to this. Format: YYYYMMDD-HHMM (see VERSION in .env).
# Build with a new tag, push, then set the same value on the server .env
# before `docker compose pull && up -d`.
VERSION=20260101-0000
# Local backup target for bin/backup/db_backup.py (host path, not compose)
BACKUP_DIR=/mnt/SR/DATA/BKP/

#### POSTGRESQL ####
# Base credentials; the postgres containers (docker-compose.dev.yml /
# docker-compose-postgres.yml) use POSTGRES_DB for the default database and
# RS-* services map DB_NAME_* into their own POSTGRES_DB_NAME.
POSTGRES_USER=socialroots
POSTGRES_DB=socialroots_default
POSTGRES_PASSWORD=th15.R00TZ
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_NAME_USERS="sr_users"
DB_NAME_GROUPS="sr_groups"
DB_NAME_NOTES="sr_notes"
DB_NAME_RESPONSES="sr_responses"
DB_NAME_NOTIFICATIONS="sr_notifications"
DB_NAME_CONNECTIONS="sr_connections"

#### REDIS ####
# REDIS_PORT is only read by `go run` / integration tests (RS-UTILS); the
# compose stack hardcodes 6379.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_EXPIRATION=43200
DISABLE_CACHE=false

#### SECURITY ####
PROFILING_ENABLED=false
# bcrypt cost for user passwords (higher = slower)
PASSWORD_COST=14
# JWT signing key — use a long random string in production
SIGNING_KEY=this-is-a-really-big-secret
# Shared secret for service-to-service calls. Generate with: openssl rand -hex 32
SR_INTERNAL_TOKEN=replace-with-32-byte-hex

#### ORCHESTRATOR ####
SR_ORCHESTRATOR_PORT=8080
SR_API_PREFIX=/api
# Session validity for login tokens (hours)
SR_SESSION_TTL_HOURS=168
# PostHog server-side analytics key (orchestrator); empty disables
POSTHOG_API_KEY=

#### MICROSERVICES ####
ROOTSHOOT_USERS_SERVICE_PORT=2600
ROOTSHOOT_GROUPS_SERVICE_PORT=2200
ROOTSHOOT_NOTES_SERVICE_PORT=2000
ROOTSHOOT_RESPONSES_SERVICE_PORT=2500
ROOTSHOOT_NOTIFICATIONS_SERVICE_PORT=2100
ROOTSHOOT_CONNECTIONS_SERVICE_PORT=2300

#### EMAIL GATEWAY (SR-EMAIL + rs-* mail config) ####
# SR-EMAIL receives email replies via webhook, queues raw messages, and
# forwards parsed replies to rs-responses; also serves POST /email/send
# (the active gateway endpoint rs-* call through SR_EMAIL_GATEWAY, wired
# internally by docker-compose.yml).
# Leave MAILGUN_API_KEY empty in development for promiscuous mode.
SR_EMAIL_PORT=2400
MAILGUN_API_KEY=
SR_EMAIL_CRON_INTERVAL=30s
EMAIL_STORE_DIR=/data/emails

# Outbound SMTP relay: dev default is the compose Mailpit (sr-mailhog),
# Web UI http://localhost:8025. Production: a real ESP (e.g. smtp.mailgun.org).
# Override with MAILGUN_HOST/ADDRESS/... on the server .env.
REPLYTO="@reply.integration.socialroots.io"
MAILGUN_ADDRESS="sr-mailhog:1025"
MAILGUN_USERNAME=
MAILGUN_PASSWORD=
MAILGUN_HOST="sr-mailhog"
# Slack notifications for system events (rs-users); empty disables
SLACK_INCOMING_WEB_HOOK=
# Email recipients allowed to actually receive mail when ENV=development
# (comma-separated; empty blocks all)
EMAIL_WHITELIST="*@test.socialroots.io"

# Public frontend origins allowed to request login emails (comma-separated).
# In development, loopback origins are always allowed in addition to this.
# Production: REQUIRED — rs-users (via ALLOWED_LOGIN_ORIGINS) rejects every
# origin if unset.
ALLOWED_LOGIN_ORIGINS=http://localhost:3000,http://localhost:8080

# Local override only, for running rs-users outside docker (go run) against
# a local sr-email. The compose stack computes this internally.
#SR_EMAIL_GATEWAY=http://localhost:2400

#### OBJECT STORAGE (MinIO / S3) ####
# MinIO service ports & root credentials (docker-compose.dev.yml /
# docker-compose.minio.yml)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_DEFAULT_BUCKET=sr-images-upload
# S3 access keys for the application (rs-users maps these to AWS_*)
S3_ACCESS_KEY_ID=sr-app-access-key
S3_SECRET_ACCESS_KEY=sr-app-secret-key-123456
# S3 endpoint depends on the docker network name:
#   dev compose       → http://sr-s3-minio:9000
#   AWS S3            → https://s3.amazonaws.com  (with AWS_REGION below)
S3_HOST=http://sr-s3-minio:9000
AWS_REGION=us-east-1

#### WEB APPS ####
# Base URL of the web app, as seen by the services (e.g. for links)
WEB_APP_HOST=http://localhost:3000
# Host port for sr-next (also the Traefik target port on servers)
SR_NEXT_PORT=3000
# Dev-only: host port for the sr-web sidecar (docker-compose.dev.yml)
WEB_DEV_PORT=8081

# SR-NEXT runtime config — read at container boot, see modules/SR-NEXT/.env.model
POSTHOG_TOKEN=
POSTHOG_HOST=https://app.posthog.com
POLL_INTERVAL=30000
CONNECT_ORG_FORM_LINK=https://docs.google.com/forms/d/e/1FAIpQLSdqNVwo8SRXgj2bQyNGvrkNObC7pOZ8711aBriebjYvwaV0rQ/viewform

#### DEPLOYMENT (docker-compose-traefik.yml overlay) ####
# Public hostname routed by Traefik (alpha.socialroots.io, socialroots.io, ...)
SR_PUBLIC_HOST=alpha.socialroots.io